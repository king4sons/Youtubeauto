SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=sk-ant-your-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
TIKTOK_CLIENT_KEY=your-tiktok-key
TIKTOK_CLIENT_SECRET=your-tiktok-secret
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-secret

# ── Telegram Bridge ───────────────────────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token below
TELEGRAM_BOT_TOKEN=

# Step 2: Message @userinfobot on Telegram to get your numeric user ID
#         Multiple users: TELEGRAM_ALLOWED_IDS=111111,222222
TELEGRAM_ALLOWED_IDS=

# Service account the bridge uses to authenticate with the Reckoning Studio API
# Change this password before exposing the API to a network
TELEGRAM_BOT_EMAIL=telegrambot@reckoning.internal
TELEGRAM_BOT_PASSWORD=change-this-password

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/youtubeauto

# JWT
JWT_SECRET=your_jwt_secret_here_change_this

# Claude AI (for script generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- VIDEO GENERATION PROVIDERS ----

# Kling AI (Kuaishou) - https://klingai.com/dev
KLING_API_KEY=your_kling_api_key
KLING_API_ENDPOINT=https://api.klingai.com

# Runway ML - https://runwayml.com
RUNWAY_API_KEY=your_runway_api_key
RUNWAY_API_ENDPOINT=https://api.runwayml.com

# Google Veo 3 (via Vertex AI) - https://cloud.google.com/vertex-ai
VEO3_API_KEY=your_google_api_key
VEO3_API_ENDPOINT=https://us-central1-aiplatform.googleapis.com/v1

# Seedance (ByteDance) - https://seedance.bytedance.com
SEEDANCE_API_KEY=your_seedance_api_key
SEEDANCE_API_ENDPOINT=https://api.seedance.ai

# LTX Studio - https://ltx.studio
LTX_API_KEY=your_ltx_api_key
LTX_API_ENDPOINT=https://api.ltx.studio

# Pika Labs - https://pika.art
PIKA_API_KEY=your_pika_api_key
PIKA_API_ENDPOINT=https://api.pika.art

# HeyGen - https://heygen.com
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_API_ENDPOINT=https://api.heygen.com

# ElevenLabs (voiceover) - https://elevenlabs.io
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVEN_API_ENDPOINT=https://api.elevenlabs.io

# ---- SOCIAL PUBLISHING (optional) ----
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

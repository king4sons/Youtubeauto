# Copy this file to .env and fill in your real keys.
# Never commit the real .env to git.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-chosen-voice-id-here

# --- Optional: use Reckoning from your phone (Telegram) ---
# See SETUP.md, "Use Reckoning from your phone" for how to get these.
# Leave blank if you only want the voice assistant on your Mac.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to your bot.
# This is a hard whitelist — anyone not on this list is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=

# --- Optional: YouTube comment idea-mining (The Reckoning Files) ---
# Read-only — fetches public comments and has Claude ideate new video topics.
# It can NEVER post, reply to, or moderate a comment; that capability doesn't
# exist in this codebase. See SETUP.md, "YouTube comment idea-mining".
# Leave blank if you don't want this feature.
YOUTUBE_API_KEY=
# Optional: lets you say "mine ideas from my last video" without naming one.
# Find it at studio.youtube.com -> Settings -> Channel -> Advanced settings.
YOUTUBE_CHANNEL_ID=

# --- Optional: Reddit research (The Reckoning Files) ---
# Read-only — uses Reddit's official app-only OAuth (no personal login, no
# cookies, no scraping). It can NEVER post, comment, vote, or moderate;
# that capability doesn't exist in this codebase.
# Register a "script" type app at reddit.com/prefs/apps to get these.
# See SETUP.md, "Reddit research" for the free-tier non-commercial-use caveat.
# Leave blank if you don't want this feature.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
